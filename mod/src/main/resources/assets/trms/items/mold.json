{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["gui"],
        "model": {
          "type": "minecraft:model",
          "model": "trms:item/mold_gui"
        }
      },
      {
        "when": ["ground"],
        "model": {
          "type": "minecraft:special",
          "base": "trms:item/mold",
          "model": {
            "type": "trms:mold_ground_special"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "trms:item/mold",
      "model": {
        "type": "trms:mold_special"
      }
    }
  }
}
