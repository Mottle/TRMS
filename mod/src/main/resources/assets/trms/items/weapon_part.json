{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["ground"],
        "model": {
          "type": "minecraft:special",
          "base": "trms:item/weapon_part",
          "model": {
            "type": "trms:weapon_part_ground_special"
          }
        }
      },
      {
        "when": ["gui"],
        "model": {
          "type": "minecraft:special",
          "base": "trms:item/weapon_part",
          "model": {
            "type": "trms:weapon_part_gui_special"
          }
        }
      },
      {
        "when": ["firstperson_lefthand", "firstperson_righthand"],
        "model": {
          "type": "minecraft:special",
          "base": "trms:item/weapon_part",
          "model": {
            "type": "trms:weapon_part_first_person_special"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "trms:item/weapon_part",
      "model": {
        "type": "trms:weapon_part_special"
      }
    }
  }
}
