{
  "multipart": [
    {
      "when": {"facing": "south"},
      "apply": {"model": "trms:block/mold"}
    },
    {
      "when": {"facing": "west"},
      "apply": {"model": "trms:block/mold", "y": 90}
    },
    {
      "when": {"facing": "north"},
      "apply": {"model": "trms:block/mold", "y": 180}
    },
    {
      "when": {"facing": "east"},
      "apply": {"model": "trms:block/mold", "y": 270}
    }
  ]
}
